# Public site URL used for canonical links, sitemap, and Open Graph.
# Production:
NEXT_PUBLIC_SITE_URL=https://www.digimark101.com

# --- Ava Skye (live model) ---
# Provide ONE provider. If none of these keys are set, Ava answers from the
# built-in studio guide and says she is in guide mode.
#
# 1) Preferred if you already use xAI / Grok (this matches earlier Vercel projects):
XAI_API_KEY=
XAI_MODEL=grok-4.7
#
# 2) Or OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
#
# 3) Or any OpenAI-compatible endpoint. If AVA_LLM_API_KEY is set, it wins
#    over XAI_API_KEY and OPENAI_API_KEY.
AVA_LLM_API_KEY=
AVA_LLM_BASE_URL=https://api.openai.com/v1
AVA_LLM_MODEL=gpt-4o-mini

# --- Supabase ---
# Project URL and the anon (or publishable) key are required for sign-in,
# the studio, and per-client row-level security. Both must be NEXT_PUBLIC_.
# Accepted URL alias: NEXT_PUBLIC_DIGIMARK_SUPABASE_URL
# Accepted key aliases: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_DIGIMARK_SUPABASE_ANON_KEY, NEXT_PUBLIC_DIGIMARK_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to store public contact-form leads. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Voice uses the browser Web Speech API. There is no speech-vendor key.

# --- PayPal membership ---
# Prices are edited in lib/paypal/membership.json, then new plans are created
# with: node scripts/paypal-create-plans.mjs
# Buttons stay in "coming soon" until the public client id and plan ids are set.
# PAYPAL_ENV defaults to sandbox when unset. Use live only for production.
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_MONTHLY=
NEXT_PUBLIC_PAYPAL_PLAN_QUARTERLY=
NEXT_PUBLIC_PAYPAL_PLAN_SEMIANNUAL=
# Server-only. Same app as the public client id. Used to verify webhooks
# and to create plans. Never prefix the secret with NEXT_PUBLIC_.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional aliases accepted by the app:
# SUPABASE_URL=
# NEXT_PUBLIC_DIGIMARK_SUPABASE_URL=
