# Public site URL used for canonical links, sitemap, and Open Graph.
# Production:
NEXT_PUBLIC_SITE_URL=https://www.digimark101.com

# --- Ava Skye (OpenAI) ---
# Required on BOTH Vercel projects: digimark101.com (repo root) and
# avaskye-online (root directory avaskye-online). Server-only. Never prefix
# with NEXT_PUBLIC_. If this is missing, Ava says so and does not guess.
# Older XAI_API_KEY and AVA_LLM_API_KEY values are ignored.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# --- Supabase ---
# Project URL and the anon (or publishable) key are required for sign-in,
# the studio, and per-client row-level security. Both must be NEXT_PUBLIC_.
# A current publishable key starts with sb_publishable_. A legacy JWT anon key also works.
# Accepted URL alias: NEXT_PUBLIC_DIGIMARK_SUPABASE_URL
# Accepted key aliases: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_DIGIMARK_SUPABASE_ANON_KEY, NEXT_PUBLIC_DIGIMARK_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Writes leads, reads lead personal details, and verifies PayPal
# webhooks. Never prefix with NEXT_PUBLIC_. Never use it for ordinary studio reads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner ---
# Server-only founder mailbox. On sign-in the server grants app_metadata.role
# owner and, when the profiles table exists, profiles.role owner.
# Never prefix with NEXT_PUBLIC_ and do not put this address in client code.
# The owner skips membership billing and seat limits and can open any workspace.
OWNER_EMAIL=

# --- Lead engine ---
# Required before any lead is stored. Salt for hashing emails on the suppression list.
# Generate a long random string and keep it stable. Never prefix with NEXT_PUBLIC_.
LEAD_HASH_SALT=
# Score at or above this value, with contact consent, enters the premium store. Default 70.
LEAD_PREMIUM_MIN_SCORE=70
# Supabase auth user id of the owner. Only this account may see premium counts
# and mark a lead order paid. Raw emails are still not rendered in the studio.
LEAD_OWNER_USER_ID=
# Bearer token for CSV and JSON imports. Server-only.
LEAD_IMPORT_KEY=
# Bearer token required by GET /api/cron/leads. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Optional HTTPS JSON API the hourly job calls. It must return
# { "leads": [ { "email", "consent_contact": true, "consent_share": false } ] }.
# Rows without consent_contact are not stored. Do not point this at a site
# whose terms forbid the collection. The job does not scrape HTML.
LEAD_CONNECTOR_URL=
LEAD_CONNECTOR_TOKEN=
# Or several connectors. tokenEnv names another env var; do not put the secret in this JSON.
# LEAD_CONNECTORS=[{"id":"owned-crm","url":"https://crm.example.com/leads.json","tokenEnv":"OWNED_CRM_TOKEN"}]
# OWNED_CRM_TOKEN=
# Optional enrichment. HTTPS POST { "email" } with a bearer key. Off when either value is missing.
ENRICHMENT_BASE_URL=
ENRICHMENT_API_KEY=

# Chat, voice chat, onboarding, the homepage introduction, and the office
# all speak through POST /api/ava/speak. The key stays on the server.
# The browser voice is used only when that request fails.
# Default OpenAI speech model is gpt-4o-mini-tts. The OpenAI voice is always
# coral (speech and realtime). AVA_TTS_VOICE is ignored so the voice cannot drift.
# Optional AVA_TTS_INSTRUCTIONS replaces the speaking style. The AY-vuh
# pronunciation rule is always included, even when this override is set. So is
# the rule that Ava never says "In the theater of life, we are all actors
# sharing the same scene," or a theater-of-life or we-are-all-actors line.
# Speech drops that sentence before audio is made.
# If both ElevenLabs values are set, they are preferred over the OpenAI voice.
# ELEVENLABS_VOICE_ID chooses the voice. Do not put a voice id in code.
# If AVA_TTS_API_KEY is unset, speech falls back to OPENAI_API_KEY.
AVA_TTS_API_KEY=
AVA_TTS_BASE_URL=https://api.openai.com/v1
AVA_TTS_MODEL=gpt-4o-mini-tts
AVA_TTS_VOICE=coral
AVA_TTS_INSTRUCTIONS=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Instant Voice Clone of the 2026-11-11 "Let's get started" clip.
# When this is set, it replaces ELEVENLABS_VOICE_ID for Ava's speech and for
# finished videos. Leave it blank until the paid ElevenLabs plan exists.
# Do not put the voice id in code.
AVA_VOICE_CLONE_ID=

# --- Video maker ---
# Finished videos are premium only. These keys turn providers on.
# None are required. With no keys, the maker can still write a script and a
# labeled preview draft. It will not pretend that draft is a finished video.
# Quality cannot be lowered from here. There is no "draft quality" switch.
#
# Ava's face. The avatar id from the Let's get started clip, after it is
# registered with the video provider. Outfit ids are optional extra looks of
# the same person. They never point at a different face.
AVA_AVATAR_ID=
# Homepage Meet Ava player. The browser loads this file, so it is public.
# Leave it empty to keep the Coming soon poster. https only, or a site path like /media/ava-intro.mp4.
# NEXT_PUBLIC_AVA_INTRO_VIDEO_URL=
# AVA_AVATAR_LOOKS={"navy-blazer":"","black-suit":"","tailored-jacket":""}
#
# Lip sync. heygen uses the HeyGen v3 studio API. generic posts the premium
# job to your URL. Status URL must contain {id}.
# HEYGEN_API_KEY=
# VIDEO_LIPSYNC_PROVIDER=heygen
# VIDEO_LIPSYNC_API_KEY=
# VIDEO_LIPSYNC_API_URL=
# VIDEO_LIPSYNC_STATUS_URL=https://example.com/videos/{id}
#
# Optional HeyGen voice id when it differs from AVA_VOICE_CLONE_ID.
# VIDEO_VOICE_ID=
#
# Cinematic plates and animated footage. The URL receives a premium job.
# VIDEO_BROLL_API_KEY=
# VIDEO_BROLL_API_URL=
# VIDEO_BROLL_STATUS_URL=https://example.com/broll/{id}
#
# Soundtrack. One request. If it fails, the video note says no soundtrack.
# Nothing is invented in its place.
# VIDEO_MUSIC_API_KEY=
# VIDEO_MUSIC_API_URL=
#
# Ready-made presenters and voices for clients. Labels only, no usage numbers.
# VIDEO_STOCK_AVATARS=[{"id":"","label":"Studio host","note":"Ready-made presenter."}]
# VIDEO_STOCK_VOICES=[{"id":"","label":"Warm narrator","note":"Ready-made voice."}]

# --- PayPal membership ---
# Prices are edited in lib/paypal/membership.json, then new plans are created
# with: node scripts/paypal-create-plans.mjs
# Buttons stay hidden until the public client id and that plan's id are set.
# The pricing card then shows Request access so the lead is not lost.
# PAYPAL_ENV defaults to sandbox when unset. Use live only for production.
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_STARTER=
NEXT_PUBLIC_PAYPAL_PLAN_MONTHLY=
NEXT_PUBLIC_PAYPAL_PLAN_QUARTERLY=
NEXT_PUBLIC_PAYPAL_PLAN_SEMIANNUAL=
# Server-only. Same app as the public client id. Used to verify webhooks
# and to create plans. Never prefix the secret with NEXT_PUBLIC_.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional aliases accepted by the app:
# SUPABASE_URL=
# NEXT_PUBLIC_DIGIMARK_SUPABASE_URL=

# --- Social OAuth ---
# Server-only. openssl rand -base64 32. Must decode to 32 bytes.
# Tokens are not stored, and Connect stays on "Needs app credentials", until this is set.
SOCIAL_TOKEN_KEY=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Production auth and social redirects use the live origins and do not
# follow preview hosts. Localhost is used only when NODE_ENV=development.
# OFFICE_PUBLIC_URL=https://www.avaskye.online

# --- Beta ---
# Server-only. Leave blank for open beta signup at /beta.
# When set, the beta form requires this exact code. Do not prefix with NEXT_PUBLIC_.
BETA_INVITE_CODE=
