# Public client configuration (not secrets). Redeploy after changing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# AI Gateway uses deployment OIDC if API key is omitted.
AI_GATEWAY_API_KEY=
AVA_MODEL=openai/gpt-4.1-mini
AVA_EMBEDDING_MODEL=openai/text-embedding-3-small
# Configure a 1536-dimensional index for the default embedding model.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
X_BEARER_TOKEN=
# Approved hosted checkout link; no automatic subscription provisioning.
PAYPAL_CHECKOUT_URL=
AVA_WALKTHROUGH_VIDEO_URL=
