# Public site URL used for canonical links, sitemap, and Open Graph.
# Production:
NEXT_PUBLIC_SITE_URL=https://www.digimark101.com

# --- Ava Skye (live model) ---
# Provide ONE provider. If none of these keys are set, Ava answers from the
# built-in studio guide and says she is in guide mode.
#
# 1) Preferred if you already use xAI / Grok (this matches earlier Vercel projects):
XAI_API_KEY=
XAI_MODEL=grok-4.7
#
# 2) Or OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
#
# 3) Or any OpenAI-compatible endpoint. If AVA_LLM_API_KEY is set, it wins
#    over XAI_API_KEY and OPENAI_API_KEY.
AVA_LLM_API_KEY=
AVA_LLM_BASE_URL=https://api.openai.com/v1
AVA_LLM_MODEL=gpt-4o-mini

# --- Supabase ---
# Project URL and the anon (or publishable) key are required for sign-in,
# the studio, and per-client row-level security. Both must be NEXT_PUBLIC_.
# A current publishable key starts with sb_publishable_. A legacy JWT anon key also works.
# Accepted URL alias: NEXT_PUBLIC_DIGIMARK_SUPABASE_URL
# Accepted key aliases: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
# NEXT_PUBLIC_DIGIMARK_SUPABASE_ANON_KEY, NEXT_PUBLIC_DIGIMARK_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Writes leads, reads lead personal details, and verifies PayPal
# webhooks. Never prefix with NEXT_PUBLIC_. Never use it for ordinary studio reads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner ---
# Server-only founder mailbox. On sign-in the server grants app_metadata.role
# owner and, when the profiles table exists, profiles.role owner.
# Never prefix with NEXT_PUBLIC_ and do not put this address in client code.
# The owner skips membership billing and seat limits and can open any workspace.
OWNER_EMAIL=

# --- Lead engine ---
# Required before any lead is stored. Salt for hashing emails on the suppression list.
# Generate a long random string and keep it stable. Never prefix with NEXT_PUBLIC_.
LEAD_HASH_SALT=
# Score at or above this value, with contact consent, enters the premium store. Default 70.
LEAD_PREMIUM_MIN_SCORE=70
# Supabase auth user id of the owner. Only this account may see premium counts
# and mark a lead order paid. Raw emails are still not rendered in the studio.
LEAD_OWNER_USER_ID=
# Bearer token for CSV and JSON imports. Server-only.
LEAD_IMPORT_KEY=
# Bearer token required by GET /api/cron/leads. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Optional HTTPS JSON API the hourly job calls. It must return
# { "leads": [ { "email", "consent_contact": true, "consent_share": false } ] }.
# Rows without consent_contact are not stored. Do not point this at a site
# whose terms forbid the collection. The job does not scrape HTML.
LEAD_CONNECTOR_URL=
LEAD_CONNECTOR_TOKEN=
# Or several connectors. tokenEnv names another env var; do not put the secret in this JSON.
# LEAD_CONNECTORS=[{"id":"owned-crm","url":"https://crm.example.com/leads.json","tokenEnv":"OWNED_CRM_TOKEN"}]
# OWNED_CRM_TOKEN=
# Optional enrichment. HTTPS POST { "email" } with a bearer key. Off when either value is missing.
ENRICHMENT_BASE_URL=
ENRICHMENT_API_KEY=

# Chat voice uses the browser Web Speech API and does not need a key.
# Optional: homepage "Hear Ava" plays a generated MP3 when AVA_TTS_API_KEY is set.
# The route calls POST {AVA_TTS_BASE_URL}/audio/speech (OpenAI-compatible).
# When the key is unset, or the provider fails, the browser speaks the same script.
# The introduction never plays until a visitor presses the button.
AVA_TTS_API_KEY=
AVA_TTS_BASE_URL=https://api.openai.com/v1
AVA_TTS_MODEL=tts-1
AVA_TTS_VOICE=nova
# Set to true only when the provider honors SSML phonemes. Default tts-1 does not.
# Either way, the spoken name is the long A (Ay-vuh). Display text stays Ava.
AVA_TTS_SSML=

# --- PayPal membership ---
# Prices are edited in lib/paypal/membership.json, then new plans are created
# with: node scripts/paypal-create-plans.mjs
# Buttons stay hidden until the public client id and that plan's id are set.
# The pricing card then shows Request access so the lead is not lost.
# PAYPAL_ENV defaults to sandbox when unset. Use live only for production.
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_STARTER=
NEXT_PUBLIC_PAYPAL_PLAN_MONTHLY=
NEXT_PUBLIC_PAYPAL_PLAN_QUARTERLY=
NEXT_PUBLIC_PAYPAL_PLAN_SEMIANNUAL=
# Server-only. Same app as the public client id. Used to verify webhooks
# and to create plans. Never prefix the secret with NEXT_PUBLIC_.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional aliases accepted by the app:
# SUPABASE_URL=
# NEXT_PUBLIC_DIGIMARK_SUPABASE_URL=

# --- Social OAuth ---
# Server-only. openssl rand -base64 32. Must decode to 32 bytes.
# Tokens are not stored, and Connect stays on "Needs app credentials", until this is set.
SOCIAL_TOKEN_KEY=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional office origin when the request host is not avaskye.online.
# OFFICE_PUBLIC_URL=https://www.avaskye.online

# --- Beta ---
# Server-only. Leave blank for open beta signup at /beta.
# When set, the beta form requires this exact code. Do not prefix with NEXT_PUBLIC_.
BETA_INVITE_CODE=
